# ============================================================================
#  .env.example — setup.sh とローカルビルドが読む環境変数のひな形
#
#  使い方:  cp .env.example .env   （setup.sh が無ければ自動で作る）
#  .env は .gitignore 済み。秘密情報をコミットしないこと。
#
#  形式: setup.sh は `set -a; . ./.env` で読み込む。つまり中身は **bash として
#  評価される**。`KEY=value` と `$HOME` 展開のみに留め、コマンド実行は書かない。
#
#  ⚠️ ここに書けるのは「ビルド/ツールチェーン」の変数だけ。
#     アプリの動作設定（AtemIp / WebPort / ProjectorDisplayIndex 等）は
#     src/Switcher.App/appsettings.json が System.Text.Json で直接読む実装で、
#     環境変数は一切見ない（Configuration/AppConfigLoader.cs）。
#     .env に AtemIp を書いても反映されないので注意。
# ============================================================================

# ---------------------------------------------------------------------------
# ツールチェーン（setup.sh がここを見て PATH を組み立てる）
# ---------------------------------------------------------------------------

# .NET 9 SDK の場所。このリポジトリでは dotnet が PATH 上に無く ~/.dotnet にある
# 前提（README「ビルド & テスト」）。システムに入れている場合は /usr/share/dotnet 等。
DOTNET_ROOT=$HOME/.dotnet

# phone-bridge が要求する Node のメジャーバージョン。ci.yml の setup-node と揃える。
# node が見つからない場合、setup.sh は nvm の読み込みを試みてからこの値を検証する。
NODE_VERSION=24

# ---------------------------------------------------------------------------
# Switcher.App ランタイム / native switcher-engine（Windows 専用・任意）
#   Linux/CI では未設定でよい。setup.ps1 が LIBOBS_* / OBS_VERSION / OBS_BIN を
#   自動で書き込むので、Windows では手で埋めるより ./setup.ps1 を走らせる方が早い。
#   読み手は native\switcher-engine\build.bat と
#   src/Switcher.App/Configuration/ObsRuntime.cs。
#
#   ⚠️ パスは `/` 区切りで書き、必ず二重引用符で囲むこと。setup.sh が bash として
#      source するため、`\` はエスケープとして食われ、`;` は区切り文字になる。
#        OK : LIBOBS_LIB="C:/obs-studio/build_x64/libobs/Release/obs.lib"
#        NG : LIBOBS_LIB=C:\obs-studio\build_x64\libobs\Release\obs.lib
# ---------------------------------------------------------------------------

# 使う OBS の版。setup.ps1 はインストール済み OBS を検出してその版に合わせ、
# 見つからない場合だけ 32.0.4 を使う。ここに書けばその値が優先される。
# マネージド側 (ObsRuntime.cs) の検証済みレンジは libobs 30.0〜32.99。
# ⚠️ obs.lib（ビルド時）と obs.dll（実行時）の版が食い違うと起動失敗/クラッシュする。
OBS_VERSION=

# OBS の data\libobs を明示指定する場合のみ。ObsRuntime がここから OBS ルートを遡る。
# 未設定ならアプリ同梱の obs-runtime\ → レジストリ → ProgramFiles の順に自動探索
# されるので通常は空でよい。
SWITCHER_OBS_DATA_PATH=

# build.bat の libobs 解決 (A) find_package 方式 — OBS の install ツリー
OBS_PREFIX=

# build.bat の libobs 解決 (B) ヘッダ + import lib を直接指定（setup.ps1 はこちらを書く）
#   LIBOBS_INCLUDE_DIR は公開ヘッダと生成ヘッダ(obsconfig.h)を `;` 区切りで両方渡す
LIBOBS_INCLUDE_DIR=
LIBOBS_LIB=

# 設定すると obs.dll をアプリ出力の隣にコピーする。未設定なら実行時に PATH を通す。
OBS_BIN=

# native ビルドの構成（build.bat 既定は Release）
CONFIG=Release

# ---------------------------------------------------------------------------
# ミラー（VPS 側。tools/mirror/{mirror,install-vps}.sh が読む・任意）
#   既定値のままで動くので、VPS を触るとき以外は空でよい。
#   SSH 鍵や tailnet の資格情報は GitHub Secrets 側（TS_CLIENT / TS_SECRET）で、
#   .env には置かない。
# ---------------------------------------------------------------------------
MIRROR_HOME=
MIRROR_REPO_DIR=
MIRROR_SOURCE_REPO=oldsheeep3/TheHack
MIRROR_TARGET_REPO=NxTEND-THE-HACK/2026-Team-38
MIRROR_PREFIX=mirror

# ---------------------------------------------------------------------------
# setup.sh の挙動（1 で該当ステップを飛ばす）
#   コマンドラインフラグ（--skip-npm 等）でも同じ制御ができる。
# ---------------------------------------------------------------------------
SETUP_SKIP_SUBMODULES=0
SETUP_SKIP_RESTORE=0
SETUP_SKIP_NPM=0
SETUP_SKIP_AGENT_SCRIPTS=0
