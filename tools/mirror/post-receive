#!/usr/bin/env bash
# 中継 bare リポジトリ（VPS: ~/mirror/TheHack.git）の post-receive フック。
# 手元の pre-push フックがここへ push すると、更新されたブランチをミラーする。
set -euo pipefail

ZERO=0000000000000000000000000000000000000000
branches=()

while read -r _old new ref; do
  case "${ref}" in
    refs/heads/*) ;;
    *) continue ;;   # タグや他の ref は mirror-sync 側で扱う
  esac
  # ブランチ削除はミラー先へ伝播させない。
  if [ "${new}" = "${ZERO}" ]; then
    continue
  fi
  branches+=("${ref#refs/heads/}")
done

if [ ${#branches[@]} -eq 0 ]; then
  exit 0
fi

exec "${MIRROR_HOME:-$HOME/mirror}/mirror.sh" "${branches[@]}"
