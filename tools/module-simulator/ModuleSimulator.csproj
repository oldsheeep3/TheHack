<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Switcher.Tools.ModuleSimulator</RootNamespace>
    <AssemblyName>ModuleSimulator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuse the production byte-layout codec (HidReportParser) and ProtocolConstants so the
         simulator can never drift from the real input report 0x01 layout. -->
    <ProjectReference Include="..\..\src\Switcher.Hid\Switcher.Hid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Raw HID access. The debug reports 0x04/0x05 are not part of Switcher.Hid's IHidDevice
         contract (which is deliberately limited to the production reports 0x01/0x02), so this
         tool talks to HidSharp directly. -->
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

</Project>
