<Window x:Class="Switcher.App.MultiviewSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mv="clr-namespace:Switcher.App.Multiview"
        Title="Multiview settings" Height="780" Width="1120"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: the whole job of this window is arranging cells, so the verbs live at the top. -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Grid" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="GridRowsCombo" Width="52" SelectionChanged="OnGridSizeChanged" ToolTip="Rows" />
                <TextBlock Text="×" VerticalAlignment="Center" Margin="5,0" Foreground="{DynamicResource TextMuted}" />
                <ComboBox x:Name="GridColsCombo" Width="52" SelectionChanged="OnGridSizeChanged" ToolTip="Columns" />
                <Border Width="1" Background="{DynamicResource Line}" Margin="10,2" />

                <TextBlock Text="Cells" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Merge selected" Click="OnMergeSelectedClick" Style="{StaticResource ToolButton}" />
                <Button Content="Split" Click="OnSplitSelectedClick" Style="{StaticResource ToolButton}" />
                <Button Content="Clear selection" Click="OnClearSelectionClick" Style="{StaticResource ToolButton}" />
                <Button Content="Empty every cell" Click="OnResetLayoutClick" Style="{StaticResource ToolButton}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                    <TextBlock Text="Show full-screen on" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0" />
                    <ComboBox x:Name="FullscreenDisplayCombo" Width="200" DisplayMemberPath="Label" />
                    <Button Content="Show full-screen" Click="OnShowFullscreenClick"
                            Style="{StaticResource ToolButtonAccent}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- The editable grid. Drag across cells to select a rectangle, then merge. -->
            <Border Grid.Column="0" Margin="12" Background="{DynamicResource Canvas}" CornerRadius="6"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="8">
                <ItemsControl x:Name="MultiviewControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <mv:MultiviewGridPanel
                                Rows="{Binding Tag.Rows, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                Cols="{Binding Tag.Cols, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" CornerRadius="4" Background="{DynamicResource Canvas}"
                                    BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}"
                                    MouseLeftButtonDown="OnMultiviewCellMouseDown"
                                    MouseEnter="OnMultiviewCellMouseEnter"
                                    MouseLeftButtonUp="OnMultiviewCellMouseUp">
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Bottom" Margin="4"
                                              ItemsSource="{Binding AvailableTokens}"
                                              SelectedItem="{Binding Token, Mode=TwoWay}"
                                              SelectionChanged="OnMultiviewCellSelectionChanged" />
                                    <Grid>
                                        <Image Source="{Binding Image}" Stretch="Uniform" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                   Margin="6,4" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Reference panel: what the tokens and the frame colours mean. -->
            <ScrollViewer Grid.Column="1" Margin="0,12,12,12" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="How this works" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"
                               Text="Drag across cells to select a rectangle, then Merge to make one big cell. Split undoes it. Pick what each cell shows from its drop-down." />

                    <TextBlock Text="Frame colours" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="26" Height="16" BorderThickness="3" CornerRadius="3"
                                BorderBrush="#FFFF2F2A" Margin="0,0,8,0" />
                        <TextBlock Text="On air now" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="26" Height="16" BorderThickness="3" CornerRadius="3"
                                BorderBrush="#FF24D07A" Margin="0,0,8,0" />
                        <TextBlock Text="Staged on preview" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="26" Height="16" BorderThickness="3" CornerRadius="3"
                                BorderBrush="#FF00BFFF" Margin="0,0,8,0" />
                        <TextBlock Text="Selected for merge" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"
                               Text="A camera cell is framed red or green too, so you can see which of your inputs is live without reading the bus row." />

                    <TextBlock Text="What you can put in a cell" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <ItemsControl x:Name="TokenLegendControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Changes apply immediately and are saved for next time." />
                <Button Content="Close" Click="OnCloseClick" HorizontalAlignment="Right"
                        Style="{StaticResource ToolButton}" MinWidth="90" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
