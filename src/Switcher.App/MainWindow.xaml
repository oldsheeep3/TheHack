<Window x:Class="Switcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switcher.App" Height="720" Width="1280"
        Background="#FF1A1A1E"
        Foreground="White">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Border" x:Key="TileBorder">
            <Setter Property="Background" Value="#FF2A2A30" />
            <Setter Property="BorderBrush" Value="#FF3C3C44" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status bar: tally + ATEM connection state -->
        <Border Grid.Row="0" Background="#FF101014" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="PGM:" Margin="0,0,4,0" FontWeight="Bold" Foreground="#FFFF5555" />
                <TextBlock x:Name="ActivePgmText" Text="-" Margin="0,0,16,0" />
                <TextBlock Text="PVW:" Margin="0,0,4,0" FontWeight="Bold" Foreground="#FF55FF55" />
                <TextBlock x:Name="ActivePvwText" Text="-" Margin="0,0,16,0" />
                <TextBlock Text="ATEM:" Margin="0,0,4,0" FontWeight="Bold" />
                <TextBlock x:Name="AtemStateText" Text="Disconnected" Margin="0,0,16,0" />
                <Button x:Name="OpenProjectorButton" Content="Open Projector" Padding="8,2" Click="OnOpenProjectorClick" />
            </StackPanel>
        </Border>

        <!-- Multiview: source tiles + PGM/PVW previews -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0">
                <ItemsControl x:Name="SourceTilesControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TileBorder}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Channel, StringFormat='Ch {0}'}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Protocol}" Opacity="0.7" />
                                    <TextBlock Text="{Binding Resolution}" Opacity="0.7" />
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource TileBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="PROGRAM" FontWeight="Bold" Foreground="#FFFF5555" />
                        <Image x:Name="ProgramImage" Stretch="Uniform" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource TileBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="PREVIEW" FontWeight="Bold" Foreground="#FF55FF55" />
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
