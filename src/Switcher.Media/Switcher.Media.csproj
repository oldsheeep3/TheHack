<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Switcher.Contracts\Switcher.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GStreamer bindings (see README.md for the required native GStreamer/NDI-plugin runtime). -->
    <PackageReference Include="GstSharp" Version="1.18.0" />
    <!-- DirectX 11 bindings for GPU texture compositing (Windows runtime required; see README.md). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GstSharp only ships lib/net45 assemblies with no compile-asset mapping for net9.0, so the
      PackageReference above (which fetches/restores the package) is paired with explicit
      references into the restored package folder. $(NuGetPackageRoot) is populated by the same
      restore, so this resolves on any machine without a hard-coded path.
    -->
    <Reference Include="glib-sharp">
      <HintPath>$(NuGetPackageRoot)gstsharp/1.18.0/lib/net45/glib-sharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="gio-sharp">
      <HintPath>$(NuGetPackageRoot)gstsharp/1.18.0/lib/net45/gio-sharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="gstreamer-sharp">
      <HintPath>$(NuGetPackageRoot)gstsharp/1.18.0/lib/net45/gstreamer-sharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
