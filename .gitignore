/*/.git/
**/softswitcher*/.git/
/.history

# Claude Code の設定。ここは独立した git リポジトリなので、この repo では追跡しない
# （追跡していない状態で gitlink だけが index に残ると actions/checkout が exit 128 で落ちる）。
/.claude/

# .NET build artifacts
[Bb]in/
[Oo]bj/

# Pico firmware build artifacts
/firmware/**/build/
firmware/pico2w-controller/test/test_config
firmware/pico2w-controller/test/test_config_sub
firmware/pico2w-controller/test/test_state_agg
firmware/pico2w-controller/test/test_backlight
firmware/pico2w-controller/test/test_settings

# switcher-module (ch32v003fun) firmware build artifacts
firmware/switcher-module/*.elf
firmware/switcher-module/*.bin
firmware/switcher-module/*.hex
firmware/switcher-module/*.lst
firmware/switcher-module/*.o
firmware/switcher-module/test/test_module_config
firmware/switcher-module/test/test_module_index
firmware/switcher-module/test/test_switches
firmware/switcher-module/test/test_adc_scale
firmware/switcher-module/test/test_sk6812_frame
firmware/switcher-module/test/test_i2c_regs
/.vs
*.user
obs-studio/
# native switcher-engine build artifacts
native/switcher-engine/build/
switcher-engine.dll

# editor history folders (any location)
**/.history/
rp2354/

# Bundled OBS runtime is assembled at package time by tools/bundle-obs-runtime.ps1
obs-runtime/

# Written into the working directory by libobs plugins at runtime: obs-browser's CEF cache and the
# service/compatibility data win-capture and rtmp-services unpack. Not ours, and rewritten every run.
/obs-browser/
/rtmp-services/
/win-capture/

# Local debug profile: it pins this machine's OBS path into PATH, so it cannot be shared.
src/Switcher.App/Properties/launchSettings.json
